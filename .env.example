# ─── Required ─────────────────────────────────────────────────────────────────
# Gemini API Key (get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# App Security
SECRET_KEY=change-this-to-a-long-random-string-in-production

# ─── Database (auto-configured in Docker Compose) ─────────────────────────────
DATABASE_URL=postgresql+asyncpg://styleai:styleai@localhost:5432/styleai

# ─── Redis (auto-configured in Docker Compose) ────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Qdrant Vector DB (auto-configured in Docker Compose) ─────────────────────
QDRANT_URL=http://localhost:6333

# ─── AWS S3 / Cloudflare R2 (Optional — falls back to local /tmp in dev) ──────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=styleai-media
S3_REGION=us-east-1
CDN_BASE_URL=

# ─── Shopping APIs (Optional — falls back to search page links) ───────────────
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=styleai-21
FLIPKART_AFFILIATE_TOKEN=

# ─── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── Gemini Model Overrides (Optional) ────────────────────────────────────────
# GEMINI_MODEL_RECOMMEND=gemini-2.5-flash
# GEMINI_MODEL_ANALYZE=gemini-2.5-pro
# GEMINI_MODEL_IMAGE=gemini-2.0-flash-preview-image-generation
